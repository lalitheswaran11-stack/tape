{
  "name": "tape",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "api-report": "node tools/api-report.mjs",
    "api-report:check": "node tools/api-report.mjs --check",
    "feed": "pnpm --filter @tape/feed dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript-eslint": "^8.15.0"
  }
}
